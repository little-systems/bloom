<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for Bloom's Windows installers.

  The signing request uploads one ZIP whose root contains the NSIS installer
  and the MSI installer. Keep this in sync with .github/workflows/sign-test.yml
  (the staging directory) whenever the bundle targets or file names change.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="bloom_*_x64-setup.exe" product-name="bloom">
      <authenticode-sign />
    </pe-file>
    <msi-file path="bloom_*_x64_en-US.msi">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
